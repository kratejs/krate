{
  "name": "@krate/3d",
  "version": "0.1.0",
  "description": "Google Filament 3D for Krate: build physically based scenes with JSX, compiled ahead of time into direct engine calls.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://krate.js.org/docs/features/3d/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kratejs/krate.git"
  },
  "bugs": {
    "url": "https://github.com/kratejs/krate/issues"
  },
  "keywords": [
    "krate",
    "3d",
    "filament",
    "webgl",
    "pbr",
    "renderer"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./runtime/compiled": "./src/runtime/compiled.ts",
    "./runtime/compiled-canvas": "./src/runtime/compiled_canvas.tsx",
    "./types": "./src/types.ts",
    "./materials/*": "./materials/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__fixtures__",
    "materials/*.filamat",
    "materials/VERSION",
    "materials/src",
    "materials/build.mjs",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "node ../../node_modules/typescript7/bin/tsc --noEmit",
    "build:materials": "node materials/build.mjs"
  },
  "peerDependencies": {
    "@krate/runtime": "^0.1.0",
    "filament": ">=1.53.0"
  },
  "devDependencies": {
    "@krate/runtime": "workspace:*",
    "happy-dom": "^20.14.5",
    "typescript": "^5.5.0",
    "vitest": "^5.0.3"
  },
  "peerDependenciesMeta": {
    "filament": {
      "optional": true
    }
  }
}
