{
  "name": "@krate/runtime",
  "version": "0.1.0",
  "description": "Client-side runtime for Krate - signals, hydration, SPA router, resources, and context.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://krate.js.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/kratejs/krate.git"
  },
  "bugs": {
    "url": "https://github.com/kratejs/krate/issues"
  },
  "keywords": [
    "signals",
    "reactive",
    "ssg",
    "hydration",
    "jsx-runtime",
    "state"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./highlight": {
      "types": "./dist/highlight.d.ts",
      "default": "./dist/highlight.js"
    },
    "./cache": {
      "types": "./dist/cache.d.ts",
      "default": "./dist/cache.js"
    },
    "./server/jsx-runtime": {
      "types": "./dist/server-jsx-runtime.d.ts",
      "default": "./dist/server-jsx-runtime.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./jsx-types": {
      "types": "./dist/jsx-types.d.ts",
      "default": "./dist/jsx-types.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./react/jsx-runtime": {
      "types": "./dist/react-jsx-runtime.d.ts",
      "default": "./dist/react-jsx-runtime.js"
    },
    "./slot": {
      "types": "./dist/slot.d.ts",
      "default": "./dist/slot.js"
    },
    "./server-handler": {
      "types": "./dist/server-handler.d.ts",
      "default": "./dist/server-handler.js"
    },
    "./node-server": {
      "types": "./dist/node-server.d.ts",
      "default": "./dist/node-server.js"
    },
    "./assets-static": {
      "types": "./dist/assets-static.d.ts",
      "default": "./dist/assets-static.js"
    },
    "./cache-adapter": {
      "types": "./dist/cache-adapter.d.ts",
      "default": "./dist/cache-adapter.js"
    },
    "./cache-redis": {
      "types": "./dist/cache-redis.d.ts",
      "default": "./dist/cache-redis.js"
    },
    "./og": {
      "types": "./dist/og.d.ts",
      "default": "./dist/og.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node bundle.cjs",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.5.0",
    "vitest": "^5.0.3"
  }
}
