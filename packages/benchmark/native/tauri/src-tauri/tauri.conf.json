{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TauriBench",
  "version": "1.0.0",
  "identifier": "dev.krate.bench.tauri",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Benchmark",
        "width": 800,
        "height": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Tauri benchmark app",
    "category": "Utility",
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  }
}
