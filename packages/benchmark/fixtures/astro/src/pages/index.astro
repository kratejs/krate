---
const items = Array.from({ length: 100 }, (_, i) => i);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Benchmark</title>
  </head>
  <body>
    <main>
      <h1>Benchmark</h1>
      <p>Static Astro page</p>
      <ul>
        {items.map((i) => (
          <li>Item {i}</li>
        ))}
      </ul>
    </main>
  </body>
</html>
