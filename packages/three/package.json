{
  "name": "@krate/three",
  "version": "0.1.0",
  "description": "A three.js renderer for Krate: build scenes with JSX, hooks and pointer events, with the react-three-fiber API.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://krate.js.org/docs/features/three/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kratejs/krate.git"
  },
  "bugs": {
    "url": "https://github.com/kratejs/krate/issues"
  },
  "keywords": [
    "krate",
    "three",
    "threejs",
    "webgl",
    "3d",
    "react-three-fiber",
    "renderer"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./drei": "./src/drei.tsx",
    "./engine": "./src/engine/index.ts",
    "./engine/drei": "./src/engine/drei.ts",
    "./engine/gltf": "./src/engine/gltf.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "LICENSE",
    "NOTICE"
  ],
  "krate": {
    "vendor": [
      "src/engine/"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@krate/runtime": "^0.1.0",
    "three": ">=0.156"
  },
  "devDependencies": {
    "@krate/runtime": "workspace:*",
    "@types/three": "^0.187.0",
    "happy-dom": "^20.14.5",
    "three": "^0.187.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.3"
  }
}
