{
  "name": "@krate/auth",
  "version": "0.1.0",
  "description": "Authentication for Krate: OAuth providers, credentials, magic links, Drizzle adapters, two-factor authentication and passkeys.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://krate.js.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/kratejs/krate.git"
  },
  "bugs": {
    "url": "https://github.com/kratejs/krate/issues"
  },
  "keywords": [
    "krate",
    "auth",
    "oauth",
    "authentication",
    "nextauth",
    "passkeys",
    "webauthn",
    "2fa",
    "totp",
    "drizzle"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./drizzle": {
      "types": "./dist/adapters/drizzle/index.d.ts",
      "default": "./dist/adapters/drizzle/index.js"
    },
    "./drizzle/ddl": {
      "types": "./dist/adapters/drizzle/ddl.d.ts",
      "default": "./dist/adapters/drizzle/ddl.js"
    },
    "./drizzle/mysql": {
      "types": "./dist/adapters/drizzle/mysql.d.ts",
      "default": "./dist/adapters/drizzle/mysql.js"
    },
    "./drizzle/pg": {
      "types": "./dist/adapters/drizzle/pg.d.ts",
      "default": "./dist/adapters/drizzle/pg.js"
    },
    "./drizzle/sqlite": {
      "types": "./dist/adapters/drizzle/sqlite.d.ts",
      "default": "./dist/adapters/drizzle/sqlite.js"
    },
    "./memory": {
      "types": "./dist/adapters/memory.d.ts",
      "default": "./dist/adapters/memory.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.3",
    "drizzle-orm": "^0.44.0",
    "@libsql/client": "^0.15.0",
    "@electric-sql/pglite": "^0.3.0"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.36.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  }
}
