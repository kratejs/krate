		}
		switch k {
		case "id":
			v.Base.ID, err = d.Int()
		case "created":
			v.Base.Created, err = d.Time()
		case "title":
			v.Title, err = d.String()
		case "note":
			v.Note, err = d.String()
		case "status":
			v.Status, err = decodeStatus(d)
		case "tags":
			v.Tags, err = decodeSliceOfString(d)
		case "grid":
			v.Grid, err = decodeSliceOfSliceOfInt(d)
		case "meta":
			v.Meta, err = decodePtrToMeta(d)
		case "attrs":
			v.Attrs, err = decodeMapOfSliceOfInt32(d)
		case "blob":
			v.Blob, err = decodeBytes(d)
		case "due":
			v.Due, err = decodePtrToTime(d)
		case "timeout":
			v.Timeout, err = decodeDuration(d)
		case "Small":
			v.Small, err = decodeUint8(d)
		case "pair":
			v.Pair, err = decodeArrayOfString(d)
		case "children":
