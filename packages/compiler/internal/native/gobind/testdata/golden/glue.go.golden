func decodeInt(d *wire.Decoder) (int, error) {
	x, err := d.Int()
	if err != nil {
		return 0, err
	}
	if x < math.MinInt || x > math.MaxInt {
		return 0, fmt.Errorf("%d overflows int", x)
	}
	return int(x), nil
}

func decodeInt32(d *wire.Decoder) (int32, error) {
	x, err := d.Int()
