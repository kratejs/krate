	e.Key("created")
	e.Time(v.Base.Created)
	e.Key("title")
	e.String(v.Title)
	if v.Note != "" {
		e.Key("note")
		e.String(v.Note)
	}
	e.Key("status")
	encodeStatus(e, v.Status)
	e.Key("tags")
	encodeSliceOfString(e, v.Tags)
	e.Key("grid")
	encodeSliceOfSliceOfInt(e, v.Grid)
	e.Key("meta")
	encodePtrToMeta(e, v.Meta)
	if len(v.Attrs) > 0 {
