{
  "name": "echo",
  "version": "1.2.0",
  "go": "example.com/krate-plugin-echo",
  "permissions": [
    { "name": "use", "description": "call the echo ops" },
    { "name": "admin", "description": "reconfigure the echo plugin" }
  ],
  "ops": [
    { "name": "Echo", "permission": "use" },
    { "name": "Shout", "permission": "use" },
    { "name": "Reset", "permission": "admin" },
    { "name": "Hand", "permission": "use", "manual": true },
    { "name": "Free" }
  ]
}
